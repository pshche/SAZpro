#!/bin/bash
PROJECT_DIR="/Users/ps/SAZ/saz-lab/targets/juice-shop"
REPORTS_DIR="$HOME/SAZ/saz-lab/reports/sast"
RULES_DIR1="/Users/ps/semgrep-rules"
RULES_DIR2="/Users/ps/.semgrep/my_rules"

echo "🔍 Начинаем сканирование juice-shop..."
cd "$PROJECT_DIR" || exit 1
mkdir -p "$REPORTS_DIR"

# Создаём .semgrepignore
cat > .semgrepignore << 'EOF'
node_modules/
dist/
build/
*.min.js
*.bundle.js
*.min.css
frontend/src/assets/private/three.js
frontend/src/assets/private/OrbitControls.js
data/static/codefixes/
*.json
*.yml
EOF
echo "✅ .semgrepignore создан"

# Проверяем существование папок правил
CONFIG_ARGS=""
if [ -d "$RULES_DIR1/javascript" ]; then
    CONFIG_ARGS="$CONFIG_ARGS --config $RULES_DIR1/javascript"
else
    echo "⚠️ Папка $RULES_DIR1/javascript не найдена, пропускаем"
fi
if [ -d "$RULES_DIR1/typescript" ]; then
    CONFIG_ARGS="$CONFIG_ARGS --config $RULES_DIR1/typescript"
else
    echo "⚠️ Папка $RULES_DIR1/typescript не найдена, пропускаем"
fi
